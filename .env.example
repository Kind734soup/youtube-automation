YOUTUBE_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here

# "manual" = paste prompts into Claude Pro yourself, no API cost or key needed
# "anthropic" = fully automated via the live Anthropic API (requires billing)
LLM_PROVIDER=manual
ANTHROPIC_MODEL=claude-opus-5

# Voice Generation Agent: which text-to-speech provider renders real audio
# from narration_manifest.json (see voice_generation_agent/providers/).
# "windows_sapi" = free, offline, local Windows SAPI voice (no key needed)
VOICE_PROVIDER=windows_sapi

# Publishing Agent: which upload provider `publish` runs against
# upload_manifest.json (see publishing_agent/providers/).
# "manual" = no API call, just a checklist for uploading by hand (no key needed)
PUBLISHING_PROVIDER=manual

# Thumbnail Agent: which LLM provider `generate` uses to write thumbnail
# concepts (see thumbnail_agent/llm_providers/). Separate from
# LLM_PROVIDER above - the two agents run independently.
# "manual" = paste prompts into Claude Pro yourself, no API cost or key needed
THUMBNAIL_LLM_PROVIDER=manual

# Visual Generation Agent: which provider `generate` uses to render real
# scene images from production_manifest.json (see visual_generation_agent/providers/).
# "placeholder" = free, offline text-card image, no key needed
# "openai_images" = real image generation via OpenAI's Images API (needs OPENAI_API_KEY + billing)
VISUAL_PROVIDER=placeholder
# Optional overrides for the openai_images provider (defaults shown):
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1536x1024
# OPENAI_IMAGE_QUALITY=medium
